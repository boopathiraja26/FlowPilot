# =========================================
# FlowPilot - Root Environment Reference
# Copy relevant values into client/.env.local and server/.env
# =========================================

# ---- Shared ----
NODE_ENV=development

# ---- Client (Next.js) ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# ---- Server (Express) ----
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# JWT setup structure (values only - implementation added in a later phase)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookies
COOKIE_SECRET=replace_with_a_long_random_secret

# ---- Database / Cache (placeholders for a future phase) ----
# DATABASE_URL=
# REDIS_URL=
