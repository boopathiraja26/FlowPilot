# =========================================
# FlowPilot - Root Environment Reference
# Copy relevant values into client/.env.local and server/.env
# =========================================

# ---- Shared ----
NODE_ENV=development

# ---- Client (Next.js) ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# ---- Server (Express) ----
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# JWT setup structure (values only - implementation added in a later phase)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookies
COOKIE_SECRET=replace_with_a_long_random_secret

# ---- Database / Queue ----
# DATABASE_URL=
REDIS_URL=redis://localhost:6379
# Required to save user-scoped Gemini/SMTP credentials. Generate a 32-byte key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the 64-hex-character value in server/.env only. Back it up securely;
# losing it makes saved integration credentials unreadable.
# INTEGRATION_ENCRYPTION_KEY=
