NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# JWT setup structure (implementation added later)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Gemini / AI workflow generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback model(s), comma-separated. Used only if verified available for the configured API key.
GEMINI_FALLBACK_MODEL=
# Total AI generation budget in milliseconds (includes retries/backoff). Default: 30000
AI_GENERATION_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookies
COOKIE_SECRET=replace_with_a_long_random_secret
